<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BotInventory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BaseOutputPath>bin/</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)/plugins/Botinventory/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />

    <!-- Build AgentVoiceFix together while keeping it as a separate plugin assembly. -->
    <ProjectReference Include="AgentVoiceFix/AgentVoiceFix.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="AgentVoiceFix/**/*.cs" />

    <!-- The official InventorySimulator plugin owns the human-facing commands. -->
    <Compile Remove="InventorySimulator.Commands.cs" />
    <EmbeddedResource
      Include="Resources/souvenir_gold_catalog.json"
      LogicalName="InventorySimulator.Resources.souvenir_gold_catalog.json"
    />
    <EmbeddedResource
      Include="Resources/bot_knife_glove_defaults.json"
      LogicalName="InventorySimulator.Resources.bot_knife_glove_defaults.json"
    />
  </ItemGroup>

  <Target Name="CopyBotInventoryGamedata" AfterTargets="Build">
    <MakeDir Directories="$(BaseOutputPath)$(Configuration)/gamedata/" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/gamedata/inventory-simulator.json"
      DestinationFolder="$(BaseOutputPath)$(Configuration)/gamedata/"
    />
  </Target>
</Project>
