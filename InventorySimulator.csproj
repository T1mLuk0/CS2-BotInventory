<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BotInventory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)Release\plugins\Botinventory</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.367" />
    <Reference Include="BotHiderApi">
      <HintPath>libs\BotHiderApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <LangFiles Include="source\InventorySimulator\lang\**\*.*" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(OutputPath)\lang" />
    <Copy
      SourceFiles="gamedata\inventory-simulator.json"
      DestinationFolder="$(OutputPath)\..\..\gamedata"
    />
  </Target>
</Project>
